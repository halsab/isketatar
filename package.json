{
  "name": "isketatar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:content": "python3 tools/validate_content.py && python3 tools/validate_production_docs.py",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test": "vitest run",
    "check": "npm run check:content && npm run check:boundaries && npm run typecheck && npm test",
    "build": "npm run typecheck && vite build && node tools/build-release.mjs && node tools/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "generate": "node tools/build-content.mjs",
    "schema:snapshot": "node tools/snapshot-content-schemas.mjs",
    "predev": "npm run generate",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate",
    "prebuild": "npm run check:content && npm run generate"
  },
  "dependencies": {
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
