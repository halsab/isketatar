{
  "name": "isketatar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:content": "python3 tools/validate_content.py && python3 tools/validate_production_docs.py",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test": "vitest run",
    "check": "npm run check:content && npm run check:boundaries && npm run typecheck && npm test && npm run test:tools",
    "test:tools": "node --test tools/*.test.mjs",
    "build": "npm run typecheck && vite build && node tools/build-worker.mjs && node tools/build-release.mjs && node tools/check-dist.mjs && npm run check:budgets",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "generate": "node tools/build-content.mjs && node tools/build-progress.mjs && node tools/build-licenses.mjs",
    "schema:snapshot": "node tools/snapshot-content-schemas.mjs",
    "predev": "npm run generate",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate",
    "prebuild": "npm run check:content && npm run generate",
    "check:budgets": "node tools/check-budgets.mjs",
    "test:performance": "node tools/measure-performance.mjs",
    "test:delivery": "node tools/delivery-smoke.mjs",
    "prepare:release": "node tools/stage-release.mjs",
    "review:package": "node tools/build-review-package.mjs",
    "check:acceptance": "node tools/check-acceptance.mjs"
  },
  "dependencies": {
    "idb": "8.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "chrome-launcher": "1.2.1",
    "fake-indexeddb": "6.2.5",
    "lighthouse": "13.4.1",
    "puppeteer-core": "25.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
